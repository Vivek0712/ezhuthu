index 0000000..2b70c60
--- /dev/null
+++ b/packages/ontology-engine/src/coa_ontology/inducer/unstructured/stores/falkordb_lexical.py
@@ -0,0 +1,91 @@
+# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""FalkorDB implementation of the LexicalGraphStore protocol.
+
+Reads a graphrag-toolkit lexical graph written through the
+``graphrag-toolkit-lexical-graph-falkordb`` contrib graph store. The queries are
+the Neptune DB ones (``ndb_lexical``) with one difference: graphrag-toolkit maps
+node ids to Neptune's ``~id`` on Neptune, but to plain node properties
+(``entityId``, ``topicId``) on every other graph store, so ``id(n)`` (FalkorDB's
+internal integer id) is replaced by those properties.
+
+Connection string: ``falkordb://host:port``; both parts are required (the
+graphrag-toolkit FalkorDB factory returns no store for a bare ``falkordb://``, so
+Scan would fail on it). Graph name defaults to ``graphrag``, the contrib store's
+default database.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from coa_ontology.inducer.unstructured.stores.ndb_lexical import (
+    _TENANT_ID_HEX_RE,
+    NeptuneDatabaseLexicalStore,
+)
+
+log = logging.getLogger(__name__)
+
+FALKORDB_PREFIX = "falkordb://"
+DEFAULT_GRAPH_NAME = "graphrag"
+
+
+def parse_falkordb_uri(uri: str) -> tuple[str, int]:
+    """Return (host, port) for ``falkordb://host:port`` (both required)."""
+    if not uri.startswith(FALKORDB_PREFIX):
+        raise ValueError(f"not a falkordb:// URI: {uri!r}")
+    host, _, port = uri[len(FALKORDB_PREFIX) :].strip("/").rpartition(":")
+    if not host or not port.isdigit():
+        raise ValueError(f"FalkorDB URI needs host:port, e.g. falkordb://localhost:6379; got {uri!r}")
+    return host, int(port)
+
+
+class FalkorDBLexicalStore(NeptuneDatabaseLexicalStore):
+    """LexicalGraphStore backed by FalkorDB (openCypher over the Redis protocol).
+
+    Args:
+        uri: ``falkordb://host:port``.
+        tenant_id: graphrag tenant suffix (hex-only or empty), as for Neptune DB.
+        graph_name: FalkorDB graph (database) name the lexical graph was written to.
+    """
+
+    def __init__(self, uri: str, tenant_id: str = "", graph_name: str = DEFAULT_GRAPH_NAME) -> None:
+        if tenant_id and not _TENANT_ID_HEX_RE.match(tenant_id):
+            raise ValueError(f"tenant_id must be hex-only or empty; got {tenant_id!r}")
+        import falkordb
+
+        host, port = parse_falkordb_uri(uri)
+        self._endpoint = f"{host}:{port}"
+        self._port = port
+        self._region = ""
+        self._tenant_id = tenant_id
+        self._graph = falkordb.FalkorDB(host=host, port=port).select_graph(graph_name)
+
+    # graphrag-toolkit stores node ids as Neptune ``~id`` (read with ``id(n)``) on
+    # Neptune, but as plain properties on other graph stores. The Neptune DB
+    # queries this class inherits use ``id(e)``/``id(subj)`` for entities and
+    # ``id(t)`` for topics; rewrite exactly those before sending.
+    _ID_REWRITES = (
+        ("id(e)", "e.entityId"),
+        ("id(subj)", "subj.entityId"),
+        ("id(t)", "t.topicId"),
+    )
+
+    def _oc_query(self, cypher: str, params: dict | None = None) -> list[dict]:
+        query_str = " ".join(cypher.split())
+        for old, new in self._ID_REWRITES:
+            query_str = query_str.replace(old, new)
+        try:
+            res = self._graph.ro_query(query_str, params=params or {})
+        except Exception as e:  # falkordb raises redis ResponseError subclasses
+            raise RuntimeError(f"FalkorDB query failed (endpoint={self._endpoint}): {e}") from e
+        header = [h[1] if isinstance(h, (list, tuple)) else h for h in res.header]
+        return [dict(zip(header, row, strict=False)) for row in res.result_set]
+
+    def health_check(self) -> dict:
+        try:
+            self._oc_query("RETURN 1 AS ping")
+            return {"status": "healthy", "backend": "falkordb"}
+        except Exception as e:
+            return {"status": "unhealthy", "backend": "falkordb", "error": str(e)}
