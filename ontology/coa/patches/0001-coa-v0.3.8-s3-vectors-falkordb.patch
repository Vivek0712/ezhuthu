+# SPDX-License-Identifier: Apache-2.0
+"""Local COA Scan: run kg_build's graphrag indexing on a local folder of .txt files.
+
+Same code path as the ECS task (graph_build._setup_graphrag, _build_indexing_config,
+_check_backend_health, _run_continuous), with the S3 staging read and the DynamoDB
+status table replaced by a local folder and an in-memory dict.
+
+    GRAPH_STORE_URI=falkordb://localhost:6379 \
+    VECTOR_STORE_URI=s3vectors://<vector-bucket>/<prefix> \
+    BEDROCK_MODEL_ARN=<extraction model or inference profile> \
+    NAMESPACE_LANGUAGE=en \
+    uv run python scripts/ezhuthu_local/scan_local.py --docs DIR --tenant HEX [--limit N]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import pathlib
+import sys
+import time
+
+
+class MemoryDAO:
+    """Stand-in for coa_common.dao.DynamoDBDAO (get/update only)."""
+
+    def __init__(self) -> None:
+        self.items: dict[str, dict] = {}
+
+    def get(self, key: dict) -> dict | None:
+        return self.items.get(json.dumps(key, sort_keys=True))
+
+    def update(self, key: dict, values: dict) -> None:
+        self.items.setdefault(json.dumps(key, sort_keys=True), {}).update(values)
+        print("status:", json.dumps(values, default=str), file=sys.stderr)
+
+
+def load_documents(folder: pathlib.Path, limit: int | None):
+    from llama_index.core import Document
+
+    docs = []
+    for path in sorted(folder.glob("*.txt"))[:limit]:
+        text = path.read_text(encoding="utf-8")
+        if not text.strip():
+            continue
+        meta = {"filename": path.name}
+        sidecar = path.with_suffix(".metadata.json")
+        if sidecar.exists():
+            meta.update({k.replace(".", "_").replace("-", "_"): v for k, v in json.loads(sidecar.read_text()).items()})
+        doc = Document(text=text, metadata=meta)
+        doc.excluded_llm_metadata_keys = list(meta)
+        doc.excluded_embed_metadata_keys = list(meta)
+        docs.append(doc)
+    return docs
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--docs", required=True, type=pathlib.Path)
+    ap.add_argument("--tenant", required=True, help="graphrag tenant id (hex, <=25 chars)")
+    ap.add_argument("--namespace", default="ezhuthu")
+    ap.add_argument("--limit", type=int, default=None)
+    args = ap.parse_args()
+
+    from coa_sources.documents.kg_build import graph_build as gb
+
+    docs = load_documents(args.docs, args.limit)
+    print(f"loaded {len(docs)} documents from {args.docs}", file=sys.stderr)
+    if not docs:
+        return 1
+    graph_uri, vector_uri = gb._setup_graphrag(args.tenant)
+    indexing_config = gb._build_indexing_config(
+        "local", args.namespace, "local", namespace_language=gb.os.environ.get("NAMESPACE_LANGUAGE", "en")
+    )
+    ddb, key = MemoryDAO(), {"PK": f"NS#{args.namespace}", "SK": "SRC#local"}
+    if not gb._check_backend_health(graph_uri, vector_uri, ddb, key):
+        return 2
+    t0 = time.time()
+    ok, failed = gb._run_continuous(docs, graph_uri, vector_uri, args.tenant, indexing_config, ddb, key, None)
+    print(json.dumps({"docs_ok": ok, "docs_failed": failed, "seconds": round(time.time() - t0, 1),
+                      "graph_store": graph_uri, "vector_store": vector_uri}))
+    return 0 if ok else 3
+
+
+if __name__ == "__main__":
+    sys.exit(main())
