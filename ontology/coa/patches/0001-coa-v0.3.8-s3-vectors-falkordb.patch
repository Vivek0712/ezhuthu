+# SPDX-License-Identifier: Apache-2.0
+"""Local COA Model: run the unstructured induction pipeline against a local lexical graph.
+
+Builds the same UnstructuredInductionConfig the ontology-engine router builds
+(routers/induce_unstructured.py) but with no DynamoDB job/proposal rows and no
+grounding service, and writes the induced Turtle to a file.
+
+    LEXICAL_GRAPH_STORE_URI=falkordb://localhost:6379 \
+    uv run python scripts/ezhuthu_local/model_local.py --namespace <uuid> --out induced.ttl
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import pathlib
+import sys
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--namespace", required=True, help="namespace UUID; tenant = to_graphrag_tenant_id(namespace)")
+    ap.add_argument("--name", default="ezhuthu-coa")
+    ap.add_argument("--uri-prefix", default="https://w3id.org/ezhuthu/coa/")
+    ap.add_argument("--description-mode", default="label_only", choices=["label_only", "instance", "schema"])
+    ap.add_argument("--confidence", type=float, default=0.5)
+    ap.add_argument("--out", required=True, type=pathlib.Path)
+    args = ap.parse_args()
+
+    from coa_common import DEFAULT_EMBED_MODEL_ID
+    from coa_ontology.bedrock_embeddings import BedrockEmbeddingClient
+    from coa_ontology.inducer.routers.induce_unstructured import _build_lexical_store
+    from coa_ontology.inducer.services.llm import LLMClient
+    from coa_ontology.inducer.unstructured.schemas import SamplingParams, UnstructuredInductionConfig
+    from coa_ontology.inducer.unstructured.services.iri_resolver import InMemoryIRIResolver
+    from coa_ontology.inducer.unstructured.services.pipeline import UnstructuredInductionPipeline
+
+    region = os.environ.get("AWS_REGION", "us-east-1")
+    store = _build_lexical_store("local", region, {}, namespace=args.namespace)
+    print("lexical store:", store.health_check(), file=sys.stderr)
+    config = UnstructuredInductionConfig(
+        namespace=args.namespace,
+        name=args.name,
+        ontology_uri_prefix=args.uri_prefix,
+        graph_arn="local",
+        confidence_threshold=args.confidence,
+        sampling=SamplingParams(),
+        description_mode=args.description_mode,
+        include_individuals=True,
+        entailment_enabled=True,
+        lexical_store=store,
+        embedding_client=BedrockEmbeddingClient(region=region, model_id=DEFAULT_EMBED_MODEL_ID, dimensions=1024),
+        description_llm=LLMClient(model_id=os.environ.get("DESCRIPTION_LLM_MODEL_ID", "us.anthropic.claude-sonnet-4-6"),
+                                  region=region),
+        iri_resolver=InMemoryIRIResolver(namespace=args.namespace, ontology_name=args.name),
+    )
+    report = UnstructuredInductionPipeline().run(config, on_status=lambda s: print("stage:", s.value, file=sys.stderr))
+    args.out.write_text(report.turtle, encoding="utf-8")
+    print(json.dumps({k: getattr(report, k) for k in ("tboxClassCount", "objectPropertyCount",
+                      "datatypePropertyCount", "conceptCount", "individualCount")}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
