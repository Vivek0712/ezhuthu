+def _register_contrib_graph_stores(graph_store_uri: str) -> None:
+    """Register the graphrag-toolkit FalkorDB contrib factory for ``falkordb://`` URIs.
+
+    FalkorDB support lives in the separate ``graphrag-toolkit-lexical-graph-falkordb``
+    package and must be registered with ``GraphStoreFactory`` before
+    ``for_graph_store`` can resolve the URI. Idempotent per process.
+    """
+    if not graph_store_uri.startswith("falkordb://"):
+        return
+    host, _, port = graph_store_uri[len("falkordb://") :].strip("/").rpartition(":")
+    if not host or not port.isdigit():
+        # graphrag's FalkorDBGraphStoreFactory returns None for an empty endpoint.
+        raise ValueError(f"GRAPH_STORE_URI needs host:port, e.g. falkordb://localhost:6379; got {graph_store_uri!r}")
+    from graphrag_toolkit.lexical_graph.storage import GraphStoreFactory
+    from graphrag_toolkit_contrib.lexical_graph.storage.graph.falkordb import FalkorDBGraphStoreFactory
+
+    GraphStoreFactory.register(FalkorDBGraphStoreFactory)
+
+
+def _store_uris_from_env() -> tuple[str, str]:
+    """Return (graph_store_uri, vector_store_uri).
+
+    ``GRAPH_STORE_URI`` / ``VECTOR_STORE_URI`` (any graphrag-toolkit connection
+    string, e.g. ``falkordb://localhost:6379`` and ``s3vectors://<bucket>/<prefix>``)
+    take precedence. Otherwise the URIs are derived from ``NEPTUNE_ENDPOINT`` and
+    ``OPENSEARCH_ENDPOINT`` exactly as before (Neptune DB + OpenSearch Serverless).
+    """
+    graph_store_uri = os.environ.get("GRAPH_STORE_URI", "").strip()
+    vector_store_uri = os.environ.get("VECTOR_STORE_URI", "").strip()
+    if not graph_store_uri:
+        neptune_host = _require_env("NEPTUNE_ENDPOINT").replace("wss://", "").replace("https://", "").rstrip("/")
+        graph_store_uri = f"neptune-db://{neptune_host}:8182"
+    if not vector_store_uri:
+        opensearch_host = (
+            _require_env("OPENSEARCH_ENDPOINT").replace("https://", "").replace("http://", "").rstrip("/")
+        )
+        vector_store_uri = f"aoss://{opensearch_host}:443"
+    _register_contrib_graph_stores(graph_store_uri)
+    return graph_store_uri, vector_store_uri
+
+
 def _setup_graphrag(tenant_id: str):
     """Configure GraphRAG and return (graph_store_uri, vector_store_uri)."""
     # Patch BEFORE importing graphrag — the monkey-patch must replace index_exists
@@ -1165,13 +1206,7 @@ def _setup_graphrag(tenant_id: str):
     if USE_BATCH_INFERENCE:
         GraphRAGConfig.extraction_batch_size = EXTRACTION_BATCH_SIZE
 
-    neptune_endpoint = _require_env("NEPTUNE_ENDPOINT")
-    opensearch_endpoint = _require_env("OPENSEARCH_ENDPOINT")
