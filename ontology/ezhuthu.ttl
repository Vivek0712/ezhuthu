ez:titleOfDynasty a owl:ObjectProperty ;
    rdfs:label "title used by dynasty"@en ;
    rdfs:domain ez:Title ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Dynasty .

ez:witnessedBy a owl:ObjectProperty ;
    rdfs:label "witnessed or administered by assembly"@en ;
    rdfs:domain ez:Grant ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Assembly .

ez:writtenIn a owl:ObjectProperty ;
    rdfs:label "written in script stage"@en ;
    rdfs:domain ez:Inscription ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:ScriptStage .

ez:Edition a owl:Class ;
    rdfs:label "Edition"@en ;
    rdfs:comment "A scholarly edition of an inscription (here a DHARMA TEI/EpiDoc file)."@en ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:subClassOf epont:Edition .

ez:Line a owl:Class ;
    rdfs:label "Line"@en ;
    rdfs:comment "A line of an inscription as numbered in the edition (<lb n>)."@en ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:subClassOf crmtex:TX7_Written_Text_Segment .

