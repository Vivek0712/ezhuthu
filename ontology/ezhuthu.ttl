ez:formulaOfDynasty a owl:ObjectProperty ;
    rdfs:label "formula used by dynasty"@en ;
    rdfs:domain ez:Formula ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Dynasty .

ez:glyph a owl:DatatypeProperty ;
    rdfs:label "Unicode glyph"@en ;
    rdfs:range xsd:string .

ez:grantType a owl:ObjectProperty ;
    rdfs:label "grant type"@en ;
    rdfs:domain ez:Grant ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:GrantType ;
    rdfs:subPropertyOf crm:P2_has_type .

