ez:grantedTo a owl:ObjectProperty ;
    rdfs:label "granted to (temple, assembly or person)"@en ;
    rdfs:domain ez:Grant ;
    rdfs:isDefinedBy ez:ontology .

ez:hasEdition a owl:ObjectProperty ;
    rdfs:label "has edition"@en ;
    rdfs:domain ez:Inscription ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Edition ;
    rdfs:subPropertyOf epont:hasEdition .

ez:hasLine a owl:ObjectProperty ;
    rdfs:label "has line"@en ;
    rdfs:domain ez:Inscription ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Line ;
    rdfs:subPropertyOf crm:P106_is_composed_of .

ez:isoValue a owl:DatatypeProperty ;
    rdfs:label "ISO-15919 value"@en ;
    rdfs:range xsd:string .

