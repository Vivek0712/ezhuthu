    rdfs:label "number of attestations in the corpus"@en ;
    rdfs:range xsd:integer .

ez:attestedIn a owl:ObjectProperty ;
    rdfs:label "attested in"@en ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Inscription .

ez:bearsTitle a owl:ObjectProperty ;
    rdfs:label "bears title"@en ;
    rdfs:domain ez:Ruler ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Title ;
    rdfs:subPropertyOf crm:P1_is_identified_by .

