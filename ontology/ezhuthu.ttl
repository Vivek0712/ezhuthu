ez:memberOfDynasty a owl:ObjectProperty ;
    rdfs:label "member of dynasty"@en ;
    rdfs:domain ez:Ruler ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:range ez:Dynasty ;
    owl:inverseOf ez:hasMember .

ez:mentions a owl:ObjectProperty ;
    rdfs:label "mentions"@en ;
    rdfs:domain ez:Inscription ;
    rdfs:isDefinedBy ez:ontology ;
    rdfs:subPropertyOf crm:P67_refers_to .

ez:paidIn a owl:ObjectProperty ;
    rdfs:label "paid in (coin or measure)"@en ;
    rdfs:domain ez:Grant ;
    rdfs:isDefinedBy ez:ontology .

