{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Ezhuthu design tokens. Source of truth: edit this file, then run `python3 design/tools/build_tokens.py` to regenerate tokens.css, tailwind-preset.js and CONTRAST.md. Names follow the materials of a Tamil inscription: stone, palm leaf, laterite, lamp-black ink and the temple lamp.",
  "color": {
    "stone": {
      "$description": "Limestone and granite, the surfaces inscriptions are cut into. Neutral, warm.",
      "50":  { "$value": "#FBF8F1" },
      "100": { "$value": "#F4EEE2" },
      "200": { "$value": "#EAE1CE" },
      "300": { "$value": "#DACDB4" },
      "400": { "$value": "#BFAE8F" },
      "500": { "$value": "#9A896C" },
      "600": { "$value": "#76674F" },
      "700": { "$value": "#564A3A" },
      "800": { "$value": "#3A3127" },
      "900": { "$value": "#241D16" }
    },
    "granite": {
      "$description": "Dark granite for dark mode, like the black stone of Chola temple walls.",
      "950": { "$value": "#13100D" },
      "900": { "$value": "#1B1713" },
      "850": { "$value": "#231E18" },
      "800": { "$value": "#2D261F" },
      "700": { "$value": "#40362B" },
      "600": { "$value": "#5A4D3E" }
    },
    "palm": {
      "$description": "Palm-leaf (ola) manuscript tones. Panels, highlights, the leaf motif.",
      "100": { "$value": "#F5EACB" },
      "200": { "$value": "#EBD9A6" },
      "300": { "$value": "#DCC07D" },
      "500": { "$value": "#B28C42" },
      "700": { "$value": "#775A22" }
    },
    "laterite": {
      "$description": "Laterite, the red stone of South Indian temples. The brand colour.",
      "100": { "$value": "#F7E0D5" },
      "300": { "$value": "#EBA07F" },
      "400": { "$value": "#D9764F" },
      "500": { "$value": "#B5502F" },
      "600": { "$value": "#9B3D22" },
      "700": { "$value": "#7E2F19" },
      "900": { "$value": "#47190C" }
    },
    "ink": {
      "$description": "Lamp-black ink (kajal soot), the colour of reading.",
      "900": { "$value": "#1D1611" },
      "700": { "$value": "#3B2F25" }
    },
    "lamp": {
      "$description": "Temple-lamp accent: brass and flame. Use for focus, highlights and the one thing to look at. Not for body text on light backgrounds.",
      "200": { "$value": "#FBDFA6" },
      "300": { "$value": "#F5C468" },
      "400": { "$value": "#EAA43A" },
      "500": { "$value": "#D2891C" },
      "700": { "$value": "#8A5508" }
    },
    "neem": {
      "$description": "Success, matched expert restoration, learner correct.",
      "100": { "$value": "#DEEBD7" },
      "300": { "$value": "#93D09C" },
      "700": { "$value": "#2C6534" },
      "900": { "$value": "#173A1D" }
    },
    "neelam": {
      "$description": "Indigo. The abstain state: 'experts are unsure'. A calm cool hue, not an error.",
      "100": { "$value": "#E3E5F4" },
      "300": { "$value": "#AEB8EC" },
      "700": { "$value": "#3B4787" },
      "900": { "$value": "#1E2448" }
    },
    "kumkum": {
      "$description": "Errors and destructive actions only.",
      "100": { "$value": "#F8DDD8" },
      "300": { "$value": "#F3A096" },
      "700": { "$value": "#A0241F" },
      "900": { "$value": "#4A1310" }
    }
  },
  "semantic": {
    "$description": "Role tokens. Components use these, never primitives. Each has a light and a dark value.",
    "bg":             { "light": "{color.stone.100}",   "dark": "{color.granite.950}" },
    "surface":        { "light": "{color.stone.50}",    "dark": "{color.granite.900}" },
    "surface-raised": { "light": "#FFFDF8",             "dark": "{color.granite.850}" },
    "surface-sunk":   { "light": "{color.stone.200}",   "dark": "{color.granite.800}" },
    "leaf":           { "light": "{color.palm.100}",    "dark": "#30271A" },
    "leaf-edge":      { "light": "{color.palm.500}",    "dark": "{color.palm.500}" },
    "border":         { "light": "{color.stone.300}",   "dark": "{color.granite.700}" },
    "border-strong":  { "light": "{color.stone.600}",   "dark": "#8A7962" },
    "text":           { "light": "{color.ink.900}",     "dark": "#F3EADA" },
    "text-muted":     { "light": "{color.stone.700}",   "dark": "#C9BBA3" },
    "text-faint":     { "light": "{color.stone.600}",   "dark": "#A8997F" },
    "accent":         { "light": "{color.laterite.600}", "dark": "{color.laterite.300}" },
    "accent-hover":   { "light": "{color.laterite.700}", "dark": "#F2B699" },
    "accent-text":    { "light": "{color.laterite.700}", "dark": "{color.laterite.300}" },
    "on-accent":      { "light": "{color.stone.50}",    "dark": "{color.granite.950}" },
    "accent-soft":    { "light": "{color.laterite.100}", "dark": "#3B2117" },
    "lamp":           { "light": "{color.lamp.500}",    "dark": "{color.lamp.400}" },
    "lamp-text":      { "light": "{color.lamp.700}",    "dark": "{color.lamp.300}" },
    "lamp-soft":      { "light": "{color.lamp.200}",    "dark": "#3A2A10" },
    "focus":          { "light": "{color.lamp.700}",    "dark": "{color.lamp.300}" },
    "ok":             { "light": "{color.neem.700}",    "dark": "{color.neem.300}" },
    "ok-soft":        { "light": "{color.neem.100}",    "dark": "{color.neem.900}" },
    "unsure":         { "light": "{color.neelam.700}",  "dark": "{color.neelam.300}" },
    "unsure-soft":    { "light": "{color.neelam.100}",  "dark": "{color.neelam.900}" },
    "error":          { "light": "{color.kumkum.700}",  "dark": "{color.kumkum.300}" },
    "error-soft":     { "light": "{color.kumkum.100}",  "dark": "{color.kumkum.900}" },
    "carve-hi":       { "light": "rgba(255, 255, 255, 0.75)", "dark": "rgba(255, 255, 255, 0.06)" },
    "carve-lo":       { "light": "rgba(60, 40, 20, 0.28)",    "dark": "rgba(0, 0, 0, 0.6)" }
  },
  "contrast": {
    "$description": "Text pairs checked by build_tokens.py. min = 4.5 (normal text, WCAG 1.4.3 AA) or 3.0 (large text >= 24px / 18.66px bold, and UI components, WCAG 1.4.11).",
    "pairs": [
      ["text", "bg", 4.5], ["text", "surface", 4.5], ["text", "surface-raised", 4.5], ["text", "surface-sunk", 4.5], ["text", "leaf", 4.5],
      ["text-muted", "bg", 4.5], ["text-muted", "surface", 4.5], ["text-muted", "surface-sunk", 4.5], ["text-muted", "leaf", 4.5],
      ["text-faint", "surface", 4.5], ["text-faint", "bg", 4.5],
      ["accent-text", "bg", 4.5], ["accent-text", "surface", 4.5], ["accent-text", "accent-soft", 4.5],
      ["on-accent", "accent", 4.5], ["on-accent", "accent-hover", 4.5],
      ["lamp-text", "bg", 4.5], ["lamp-text", "surface", 4.5], ["lamp-text", "lamp-soft", 4.5],
      ["ok", "surface", 4.5], ["ok", "ok-soft", 4.5],
      ["unsure", "surface", 4.5], ["unsure", "unsure-soft", 4.5],
      ["error", "surface", 4.5], ["error", "error-soft", 4.5],
      ["text", "lamp-soft", 4.5], ["text", "unsure-soft", 4.5], ["text", "ok-soft", 4.5], ["text", "error-soft", 4.5], ["text", "accent-soft", 4.5],
      ["focus", "bg", 3.0], ["focus", "surface", 3.0], ["border-strong", "surface", 3.0], ["accent", "surface", 3.0]
    ]
  },
  "space": {
    "$description": "4px base. Use the named steps; never ad hoc values.",
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px",
    "gutter": "16px", "gutter-wide": "28px", "measure": "68ch", "measure-ta": "60ch", "page-max": "1120px", "tap": "44px"
  },
  "radius": {
    "xs": "4px", "sm": "8px", "md": "12px", "lg": "18px", "xl": "28px", "pill": "999px",
    "stele": "50% 50% 10px 10px / 34% 34% 10px 10px"
  },
  "shadow": {
    "light": {
      "1": "0 1px 0 rgba(255,255,255,.7) inset, 0 1px 2px rgba(60,35,10,.10)",
      "2": "0 1px 0 rgba(255,255,255,.6) inset, 0 10px 30px -18px rgba(60,35,10,.45)",
      "3": "0 1px 0 rgba(255,255,255,.6) inset, 0 24px 48px -24px rgba(60,35,10,.50)",
      "carved": "inset 0 1px 2px rgba(60,40,20,.28), 0 1px 0 rgba(255,255,255,.75)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0,0,0,.5)",
      "2": "0 10px 30px -18px rgba(0,0,0,.85)",
      "3": "0 24px 48px -24px rgba(0,0,0,.9)",
      "carved": "inset 0 1px 2px rgba(0,0,0,.6), 0 1px 0 rgba(255,255,255,.06)"
    }
  },
  "motion": {
    "$description": "Calm and short. Everything collapses to 0ms under prefers-reduced-motion.",
    "duration": { "instant": "80ms", "fast": "140ms", "base": "220ms", "slow": "420ms", "reveal": "900ms" },
    "easing": {
      "standard": "cubic-bezier(.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, .2, 1)",
      "exit": "cubic-bezier(.4, 0, 1, 1)",
      "chisel": "cubic-bezier(.65, 0, .35, 1)"
    }
  },
  "font": {
    "family": {
      "display-latin": "'Fraunces', 'Noto Serif Tamil', Georgia, 'Times New Roman', serif",
      "display-ta": "'Noto Serif Tamil', 'Tamil Sangam MN', 'Latha', serif",
      "body": "'Instrument Sans', 'Noto Sans Tamil', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "body-ta": "'Noto Sans Tamil', 'Instrument Sans', 'Tamil MN', 'Latha', system-ui, sans-serif",
      "brahmi": "'Noto Sans Brahmi', sans-serif",
      "grantha": "'Noto Sans Grantha', 'Noto Sans Tamil', sans-serif",
      "chola": "'Noto Serif Tamil', serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace"
    },
    "scale": {
      "$description": "Major-third (1.25) scale on a 16px root. Tamil sizes step down one notch at display sizes because Tamil glyphs are wider and taller at the same em.",
      "xs":  { "size": "0.8rem",  "lh-latin": 1.5,  "lh-ta": 1.7 },
      "sm":  { "size": "0.9rem",  "lh-latin": 1.5,  "lh-ta": 1.7 },
      "md":  { "size": "1.0625rem", "lh-latin": 1.6, "lh-ta": 1.8 },
      "lg":  { "size": "1.25rem", "lh-latin": 1.5,  "lh-ta": 1.7 },
      "xl":  { "size": "1.5625rem", "lh-latin": 1.3, "lh-ta": 1.5 },
      "2xl": { "size": "1.95rem", "lh-latin": 1.2,  "lh-ta": 1.45 },
      "3xl": { "size": "2.44rem", "lh-latin": 1.12, "lh-ta": 1.4 },
      "4xl": { "size": "3.05rem", "lh-latin": 1.05, "lh-ta": 1.35 },
      "glyph": { "size": "4.5rem", "lh-latin": 1, "lh-ta": 1.1 }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  }
}
